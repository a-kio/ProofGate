{
  "name": "proofgate",
  "version": "1.0.0",
  "private": true,
  "description": "AI wrote it. ProofGate verifies it.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:cli && pnpm build:dashboard && node scripts/copy-dashboard.mjs",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build:cli": "pnpm --filter @proofgate/cli build",
    "build:dashboard": "pnpm --filter @proofgate/dashboard build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @proofgate/dashboard typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/end-to-end",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev": "pnpm --filter @proofgate/cli dev",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:self": "node apps/cli/dist/index.js verify --profile thorough",
    "release:sea": "node scripts/build-sea.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "playwright-core": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5"
  },
  "keywords": [
    "proofgate",
    "ai-agent",
    "ai-agents",
    "coding-agent",
    "coding-agents",
    "verification",
    "independent-verification",
    "acceptance-criteria",
    "acceptance-testing",
    "evidence-bundle",
    "anti-hallucination",
    "claude-code",
    "cursor",
    "cursor-ai",
    "gemini-cli",
    "codex",
    "opencode",
    "windsurf",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "test-runner",
    "ci-cd",
    "devops",
    "software-quality",
    "sha256-manifest",
    "tamper-proof",
    "local-first",
    "zero-telemetry",
    "developer-tools",
    "node",
    "typescript",
    "cli",
    "dashboard",
    "vitest",
    "jest",
    "playwright",
    "ai-safety",
    "agentic-workflow",
    "code-review",
    "gatekeeper"
  ],
  "homepage": "https://github.com/a-kio/ProofGate",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-kio/ProofGate.git"
  },
  "bugs": {
    "url": "https://github.com/a-kio/ProofGate/issues"
  },
  "author": "a-kio"
}
