{
  "name": "@proofgate/mcp-server",
  "version": "1.0.0",
  "description": "ProofGate stdio MCP server for agent integration",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@proofgate/config": "workspace:*",
    "@proofgate/core": "workspace:*",
    "@proofgate/integrations": "workspace:*",
    "@proofgate/project-detection": "workspace:*",
    "@proofgate/shared": "workspace:*",
    "@proofgate/storage": "workspace:*",
    "zod": "^4.6.7"
  }
}
