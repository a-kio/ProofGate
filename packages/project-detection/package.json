{
  "name": "@proofgate/project-detection",
  "version": "1.0.0",
  "description": "Project, ecosystem, tooling, and Git change detection for ProofGate",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofgate/executor": "workspace:*",
    "@proofgate/shared": "workspace:*"
  }
}
